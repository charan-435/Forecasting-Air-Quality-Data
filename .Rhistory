if (file.exists(series_path)) {
packed <- readRDS(series_path)
raw <- packed$raw
series <- packed$series
} else {
raw <- load_raw_datasets()
series <- prepare_all_series(raw)
}
scores <- if (file.exists(file.path(RES_DIR, "scores.rds")))
readRDS(file.path(RES_DIR, "scores.rds")) else NULL
hparams <- if (file.exists(file.path(RES_DIR, "hparams.rds")))
readRDS(file.path(RES_DIR, "hparams.rds")) else NULL
