})
# Chunk 7: eda-missing
missing_tbl <- dplyr::bind_rows(lapply(series, function(s) {
tibble(sensor = s$sensor, pollutant = s$pollutant,
n = length(s$y), n_missing_in_file = s$n_missing,
n_clipped_impossible = s$n_impossible,
n_flat_runs_ge6h = {
r <- rle(round(s$y, 6))
sum(r$lengths >= 6)
})
}))
missing_tbl
# Chunk 8: eda-adf
renderTable({
s <- s_re()
y <- s$y
adf <- tryCatch(tseries::adf.test(y, alternative = "stationary"), error = function(e) NULL)
kpss <- tryCatch(urca::ur.kpss(y, type = "mu"), error = function(e) NULL)
tibble(
test = c("ADF (H0: unit root)", "KPSS statistic (H0: level stationary)"),
statistic = c(if (is.null(adf)) NA else unname(adf$statistic),
if (is.null(kpss)) NA else kpss@teststat),
p_or_cv = c(if (is.null(adf)) NA else adf$p.value,
if (is.null(kpss)) NA else kpss@cval[2])
)
})
# Chunk 9: eda-acf
renderPlot({
s <- s_re()
y <- s$y
lag.max <- input$lagmax
par(mfrow = c(1, 2), mar = c(4, 4, 2, 1))
acf(y, lag.max = lag.max, main = paste("ACF", input$pollutant), na.action = na.pass)
pacf(y, lag.max = lag.max, main = paste("PACF", input$pollutant), na.action = na.pass)
})
# Chunk 10: eda-scatter
renderPlotly({
s <- s_re()
k <- input$lagk
y <- s$y
df <- tibble(y_lag = y[1:(length(y) - k)], y_now = y[(k + 1):length(y)])
p <- ggplot(df, aes(y_lag, y_now)) +
geom_point(alpha = 0.15, size = 0.6, colour = "#1F3A5F") +
geom_smooth(method = "loess", se = FALSE, colour = "#A64B2A", linewidth = 0.9) +
labs(x = paste0("y(t-", k, ")"), y = "y(t)",
title = paste("Lag", k, "scatter"))
ggplotly(p)
})
# Chunk 11: eda-pacf-cutoff
renderText({
s <- s_re()
cut <- pacf_cutoff(s$y, max_lag = input$lagmax)
paste0("PACF cutoff on this series (95% band, max lag ", input$lagmax,
"): p = ", cut, " hours.")
})
# Chunk 12: eda-stl
renderPlot({
s <- s_re()
yts <- ts(s$y, frequency = 24)
st <- stl(yts, s.window = "periodic", robust = TRUE)
plot(st, main = paste("STL", input$sensor, input$pollutant))
})
# Chunk 13: eda-energy
renderPlot({
s <- s_re()
pick <- choose_J(s$y)
en <- pick$energy
barplot(en$share, names.arg = en$component, las = 2, col = "#1F3A5F",
ylab = "Energy share",
main = sprintf("MODWT energy  |  paper J = %s, elbow J = %s",
pick$J_paper, pick$J_elbow))
})
# Chunk 14: eda-mra
renderPlot({
s <- s_re()
J <- max(input$jlev, 3)
mra <- haar_mra(s$y, J)
rec <- mra_reconstruct(mra)
t <- s$times
j <- input$jlev
layout(matrix(1:3, ncol = 1), heights = c(1, 1, 1))
par(mar = c(2, 4, 2, 1))
plot(t, s$y, type = "l", col = "#1F3A5F", ylab = "Y(t)", xlab = NA,
main = "Original (Haar MRA adds back to this)")
plot(t, mra$D[[j]], type = "l", col = "#A64B2A", ylab = paste0("D", j), xlab = NA)
plot(t, mra$S, type = "l", col = "#2E6B4F", ylab = paste0("S", J), xlab = "Time")
})
# Chunk 15: eda-recon
renderText({
s <- s_re()
J <- max(3L, input$jlev)
mra <- haar_mra(s$y, J)
err <- max(abs(mra_reconstruct(mra) - s$y))
paste0("Max reconstruction error at J = ", J, ": ", signif(err, 3),
" (should be ~0; Haar MRA is additive).")
})
# Chunk 16: preprocess-demo
demo <- series[["CPCB_PM2.5"]]
sp <- chrono_split(demo$y, demo$times, HORIZONS[["7d"]])
sc <- minmax_fit(sp$y_train)
tibble(
train_n = length(sp$y_train),
test_n = length(sp$y_test),
train_min = sc$min,
train_max = sc$max,
test_min = min(sp$y_test),
test_max = max(sp$y_test),
note = "Test min/max are NOT used in the scaler (no leakage)."
)
# Chunk 17: hparams
if (is.null(hparams)) {
cat("No results/hparams.rds yet. Run run_experiments.R from the project root.\n")
} else {
cat(hparams$reason, "\n")
if (!is.null(hparams$grid_lgb)) {
knitr::kable(head(hparams$grid_lgb, 8), digits = 3,
caption = "LightGBM time-based grid (train only), best first")
}
if (!is.null(hparams$grid_wave)) {
knitr::kable(hparams$grid_wave, digits = 3,
caption = "WaveLGBM J grid at the winning lag/depth/eta")
}
}
# Chunk 18: conformal-plot
if (is.null(conf)) {
cat("No results/conformal.rds yet. Run run_experiments.R.\n")
} else {
inputPanel(
selectInput("conf_sensor", "Conformal series", names(conf), selected = names(conf)[1])
)
}
# Chunk 19: conformal-fig
if (!is.null(conf)) {
renderPlotly({
z <- conf[[input$conf_sensor]]
df <- tibble(Datetime = z$t_test, actual = z$y_test, pred = z$yhat,
lo = z$lower, hi = z$upper)
p <- ggplot(df, aes(Datetime)) +
geom_ribbon(aes(ymin = lo, ymax = hi), fill = "#1F3A5F", alpha = 0.18) +
geom_line(aes(y = actual, colour = "Actual")) +
geom_line(aes(y = pred, colour = "WaveCatBoost")) +
scale_colour_manual(values = c(Actual = "#1F3A5F", WaveCatBoost = "#A64B2A")) +
labs(y = "PM2.5", x = NULL, colour = NULL,
title = sprintf("%s PM2.5 7-day  |  kappa = %s  |  test coverage = %.0f%%",
z$sensor, z$kappa, 100 * z$coverage_test))
ggplotly(p)
})
}
# Chunk 20: conformal-alert
if (!is.null(conf)) {
dplyr::bind_rows(lapply(conf, function(z) {
dplyr::mutate(z$alert, sensor = z$sensor, coverage_test = z$coverage_test,
mean_width = z$width, kappa = z$kappa)
}))
}
# Chunk 21: scores-table
if (is.null(scores) || !nrow(scores)) {
cat("No results/scores.rds yet. From the project root run:\n",
"  Rscript run_experiments.R        # full 6 x 2 x 4 bake-off\n",
"  Rscript run_experiments.R quick  # 1-day, snaive/sarima/lgb/wavelgb\n")
} else {
DT::datatable(scores %>% dplyr::mutate(dplyr::across(c(MASE, MAE, RMSE), ~round(., 3))),
caption = "All cached forecasts", options = list(pageLength = 12))
}
# Chunk 22: scores-wide
if (!is.null(scores) && nrow(scores)) {
wide <- scores %>%
dplyr::select(sensor, pollutant, horizon, method, MASE) %>%
tidyr::pivot_wider(names_from = method, values_from = MASE)
knitr::kable(wide, digits = 3, caption = "MASE (lower is better)")
}
# Chunk 23: mcb
if (!is.null(scores) && nrow(scores) > 4) {
mcb <- tryCatch(mcb_from_table(scores), error = function(e) NULL)
if (!is.null(mcb)) {
knitr::kable(mcb, digits = 3,
caption = "MCB / Nemenyi mean ranks across pollutant–sensor–horizon cases")
renderPlot({
rng <- range(c(mcb$lo, mcb$hi))
plot(mcb$mean_rank, seq_len(nrow(mcb)), pch = 16, xlim = rng,
yaxt = "n", xlab = "Mean rank (lower is better)", ylab = NA,
main = "MCB-style ranks")
axis(2, at = seq_len(nrow(mcb)), labels = mcb$model, las = 1)
segments(mcb$lo, seq_len(nrow(mcb)), mcb$hi, seq_len(nrow(mcb)))
abline(v = min(mcb$mean_rank) + unique(mcb$critical_distance) / 2,
lty = 2, col = "#A64B2A")
})
}
}
args <- commandArgs(trailingOnly = TRUE)
QUICK <- any(tolower(args) %in% c("quick", "--quick", "-q"))
file_arg <- grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)
if (length(file_arg)) {
setwd(dirname(normalizePath(sub("^--file=", "", file_arg))))
}
if (!file.exists("R/load_all.R")) stop("Run this script from the project root.")
source("R/load_all.R")
cache_path <- file.path(RES_DIR, "forecast_cache.rds")
score_path <- file.path(RES_DIR, "scores.rds")
hparam_path <- file.path(RES_DIR, "hparams.rds")
series_path <- file.path(PROC_DIR, "series.rds")
conformal_path <- file.path(RES_DIR, "conformal.rds")
eda_path <- file.path(RES_DIR, "eda_summary.rds")
METHODS_PLAIN <- c("snaive", "sarima", "xgb", "lgb", "catboost")
METHODS_WAVE <- c("wavesarima", "wavexgb", "wavelgb", "wavecatboost")
METHODS <- c(METHODS_PLAIN, METHODS_WAVE)
if (QUICK) {
message("QUICK mode: 1-day horizon only, LightGBM family + snaive/sarima.")
METHODS <- c("snaive", "sarima", "lgb", "wavelgb")
}
load_cache <- function(path) {
if (file.exists(path)) readRDS(path) else list()
}
save_cache <- function(obj, path) {
saveRDS(obj, path)
}
# ---- 1. Data --------------------------------------------------------------
message("Loading raw datasets...")
raw <- load_raw_datasets()
series <- prepare_all_series(raw)
saveRDS(list(raw = raw, series = series), series_path)
# EDA summaries used by the Rmd even before a full knit.
eda <- lapply(series, function(s) {
y <- s$y
adf_p <- tryCatch(tseries::adf.test(y, alternative = "stationary")$p.value, error = function(e) NA)
kpss_p <- tryCatch(urca::ur.kpss(y)@teststat, error = function(e) NA)
jpick <- choose_J(y)
tibble::tibble(
sensor = s$sensor, pollutant = s$pollutant, n = length(y),
n_missing_raw = s$n_missing,
mean = mean(y), sd = sd(y), min = min(y), max = max(y),
adf_p = adf_p, J_paper = jpick$J_paper, J_elbow = jpick$J_elbow
)
})
eda_df <- dplyr::bind_rows(eda)
saveRDS(eda_df, eda_path)
print(eda_df)
# ---- 2. Hyperparameters on CPCB PM2.5 ------------------------------------
pm_key <- "CPCB_PM2.5"
J_elbow <- choose_J(series[[pm_key]]$y)$J_elbow
if (file.exists(hparam_path)) {
hp <- readRDS(hparam_path)
message("Loaded cached hyperparameters: ", hp$reason)
} else if (QUICK) {
hp <- list(
params = default_tree_params(),
J = J_elbow,
grid_lgb = NULL,
grid_wave = NULL,
reason = paste("QUICK defaults p=24, depth=6, eta=0.08, J=", J_elbow)
)
saveRDS(hp, hparam_path)
} else {
hp <- tryCatch(
choose_hparams(series[[pm_key]], J_elbow),
error = function(e) {
message("Hparam search failed (", e$message, "); using defaults.")
list(
params = default_tree_params(),
J = J_elbow,
grid_lgb = NULL,
grid_wave = NULL,
reason = paste("Defaults p=24, depth=6, eta=0.08, J=", J_elbow,
"(grid failed:", e$message, ")")
)
}
)
saveRDS(hp, hparam_path)
}
# Cap J at 5 (32-hour scale): extra Haar levels are extra CatBoost models and
# were ~4x slower in a J=9 trial, with little extra daily-cycle information.
if (hp$J > 5L) {
hp$reason <- paste0(hp$reason, " Modelling cap: J=", hp$J, " -> 5.")
hp$J <- 5L
}
message(hp$reason)
params <- hp$params
params$nrounds <- min(params$nrounds, 120L)
J_use <- hp$J
# ---- 3. Bake-off ----------------------------------------------------------
cache <- load_cache(cache_path)
horizons_use <- if (QUICK) HORIZONS["1d"] else HORIZONS
# PM2.5 first (used in conformal + hparams), then 1-day for every pollutant, then the rest.
job_rank <- function(pollutant, horizon) {
p_rank <- if (identical(pollutant, "PM2.5")) 0 else 1
h_rank <- match(horizon, c("1d", "7d", "14d", "31d"), nomatch = 9)
p_rank * 10 + h_rank
}
jobs <- list()
for (s in series) {
for (hn in names(horizons_use)) {
h <- horizons_use[[hn]]
if (h >= length(s$y)) next
for (m in METHODS) {
key <- paste(s$sensor, s$pollutant, hn, m, sep = "|")
jobs[[key]] <- list(sensor = s$sensor, pollutant = s$pollutant,
horizon = hn, h = h, method = m, series = s, key = key,
rank = job_rank(s$pollutant, hn))
}
}
}
jobs <- jobs[order(vapply(jobs, `[[`, numeric(1), "rank"))]
message("Jobs: ", length(jobs), " | already cached: ",
sum(names(jobs) %in% names(cache)))
n_done <- 0L
for (job in jobs) {
if (job$key %in% names(cache)) next
s <- job$series
split <- chrono_split(s$y, s$times, job$h)
# Trees + wave-trees: min-max on train only. SARIMA / snaive: original scale.
use_scale <- job$method %in% c("xgb", "lgb", "catboost", "wavexgb", "wavelgb", "wavecatboost")
if (use_scale) {
sc <- minmax_fit(split$y_train)
ytr <- minmax_apply(split$y_train, sc)
} else {
sc <- NULL
ytr <- split$y_train
}
message(sprintf("[%s] %s %s %s h=%s",
format(Sys.time(), "%H:%M:%S"), job$sensor, job$pollutant,
job$method, job$horizon))
t0 <- proc.time()[3]
out <- tryCatch(
fit_and_forecast(job$method, ytr, h = job$h, params = params, J = J_use),
error = function(e) {
message("  ERROR: ", e$message)
NULL
}
)
elapsed <- proc.time()[3] - t0
if (is.null(out)) {
cache[[job$key]] <- list(error = TRUE, key = job$key)
save_cache(cache, cache_path)
next
}
yhat <- out$yhat
if (use_scale) yhat <- minmax_invert(yhat, sc)
sc_tbl <- score_forecast(split$y_train, split$y_test, yhat)
cache[[job$key]] <- list(
error = FALSE,
sensor = job$sensor,
pollutant = job$pollutant,
horizon = job$horizon,
method = job$method,
y_test = split$y_test,
t_test = split$t_test,
yhat = yhat,
scores = sc_tbl,
elapsed = elapsed,
fallback = isTRUE(out$fit$fallback)
)
n_done <- n_done + 1L
if (n_done %% 2L == 0L) save_cache(cache, cache_path)
if (n_done %% 10L == 0L) {
tmp <- dplyr::bind_rows(lapply(cache, function(z) {
if (isTRUE(z$error) || is.null(z$scores)) return(NULL)
dplyr::bind_cols(
tibble::tibble(sensor = z$sensor, pollutant = z$pollutant,
horizon = z$horizon, method = z$method, elapsed = z$elapsed),
z$scores
)
}))
saveRDS(tmp, score_path)
readr::write_csv(tmp, file.path(RES_DIR, "scores.csv"))
}
}
install.packages("EMD")
"C:/Program Files/R/R-4.6.1/bin/Rscript.exe" run_experiments.R
source("run_experiments.R")
source("run_experiments.R")
